  "sections": [
    {
      "type": "html",
      "html": "<section aria-label=\"Kanban board\">\n  <div class=\"cluster\" style=\"justify-content: space-between; margin-bottom: var(--sp-4);\">\n    <h2>Sprint Board</h2>\n    <span class=\"small muted\">9 tasks total · Committed velocity 34 pt</span>\n  </div>\n  <div class=\"kanban\" data-kanban>\n    <div class=\"kanban-col\" data-col=\"Backlog\">\n          <header class=\"kanban-col-head\">\n            <span class=\"kanban-col-title\">Backlog</span>\n            <span class=\"badge\">3</span>\n          </header>\n          <div class=\"kanban-cards\">\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Improve the password reset email copy</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">auth</span>\n                <span class=\"chip\">3pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Misaki Sato</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Measure dashboard load speed</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">perf</span>\n                <span class=\"chip\">5pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Kenta Tanaka</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Make the notification settings screen mobile-friendly</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">mobile</span>\n                <span class=\"chip\">8pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Unassigned</span>\n              </div>\n            </article>\n          </div>\n        </div>\n    <div class=\"kanban-col\" data-col=\"In Progress\">\n          <header class=\"kanban-col-head\">\n            <span class=\"kanban-col-title\">In Progress</span>\n            <span class=\"badge badge-info\">3</span>\n          </header>\n          <div class=\"kanban-cards\">\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Migrate the billing API to Stripe v2</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">billing</span>\n                <span class=\"chip\">api</span>\n                <span class=\"chip\">8pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Daisuke Suzuki</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Implement the onboarding tour UI</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">frontend</span>\n                <span class=\"chip\">5pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Yuka Takahashi</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Audit log export feature</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">security</span>\n                <span class=\"chip\">3pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Sho Watanabe</span>\n              </div>\n            </article>\n          </div>\n        </div>\n    <div class=\"kanban-col\" data-col=\"Done\">\n          <header class=\"kanban-col-head\">\n            <span class=\"kanban-col-title\">Done</span>\n            <span class=\"badge badge-success\">3</span>\n          </header>\n          <div class=\"kanban-cards\">\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Integrate the CI pipeline with GitHub Actions</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">devops</span>\n                <span class=\"chip\">5pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Kenta Tanaka</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Fix SSO login error handling</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">auth</span>\n                <span class=\"chip\">2pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Misaki Sato</span>\n              </div>\n            </article>\n            <article class=\"kanban-card card-outlined\" tabindex=\"0\" aria-roledescription=\"Draggable card\">\n              <p class=\"kanban-card-title\">Localize the terms of service page</p>\n              <div class=\"cluster\" style=\"gap: var(--sp-1); margin-top: var(--sp-2);\">\n                <span class=\"chip\">i18n</span>\n                <span class=\"chip\">3pt</span>\n              </div>\n              <div class=\"kanban-card-foot\">\n                <span class=\"small muted\">Assignee: Yuka Takahashi</span>\n              </div>\n            </article>\n          </div>\n        </div>\n  </div>\n</section>",
      "cssModules": [
        "kanban-board"
      ]
    },
    {
      "type": "html",
      "html": "<section aria-label=\"Board appearance settings\">\n  <h2 style=\"margin-bottom: var(--sp-4);\">Board Appearance Settings</h2>\n  <figure class=\"slider-control card-outlined\">\n    <figcaption class=\"eyebrow\">Card Radius</figcaption>\n\n    <div class=\"slider-row\">\n      <label for=\"slider-x\">Card radius</label>\n      <input type=\"range\" id=\"slider-x\"\n             min=\"0\" max=\"24\" value=\"12\" step=\"1\"\n             data-slider=\"--card-radius\" data-out=\"#xval\" data-unit=\"px\"\n             aria-label=\"Card radius\">\n      <output class=\"slider-out\" id=\"xval\" for=\"slider-x\">12px</output>\n    </div>\n\n    <!-- live preview: any element reading var(--card-radius) updates as the slider moves -->\n    <div class=\"preview-stage\">\n      <div class=\"preview-box\" role=\"img\" aria-label=\"Live preview of card radius\"></div>\n    </div>\n\n    <div class=\"cluster\">\n      <button class=\"btn btn-ghost btn-sm\" data-copy-text=\".kanban-card { border-radius: var(--card-radius); }\">Copy as CSS</button>\n    </div>\n  </figure>\n</section>",
      "cssModules": [
        "slider-control"
      ]
    }
  ]
}

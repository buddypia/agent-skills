{
  "title": "Workspace settings & access",
  "eyebrow": "Form controls",
  "subtitle": "Themed checkboxes, radios, switches, and inputs — the elements.css form-control primitives, plus the checklist and form sections.",
  "theme": "interactive-warm",
  "layout": "stack",
  "header": "banner",
  "footer": "Generated by html-artifacts · form-controls showcase",
  "meta": [
    { "k": "Surface", "v": "web · document" },
    { "k": "Owner", "v": "Platform team" }
  ],
  "sections": [
    {
      "type": "callout",
      "variant": "note",
      "title": "Real, themed controls",
      "body": "Every control on this page is a real <input>/<select>/<textarea> styled by the shared form-control primitives — they take the active theme's accent, radius, and dark/light surface automatically."
    },
    {
      "type": "checklist",
      "title": "Notification preferences",
      "control": "switch",
      "items": [
        { "label": "Product updates", "desc": "Release notes and new features", "checked": true },
        { "label": "Security alerts", "desc": "Sign-ins and credential changes", "checked": true },
        { "label": "Weekly digest", "desc": "A Monday summary of activity" },
        { "label": "Marketing email", "desc": "Tips, offers, and surveys" }
      ]
    },
    {
      "type": "checklist",
      "title": "Default workspace (pick one)",
      "control": "radio",
      "name": "workspace",
      "variant": "boxed",
      "items": [
        { "label": "Platform", "desc": "Infra, CI/CD, observability", "checked": true },
        { "label": "Growth", "desc": "Experiments and analytics" },
        { "label": "Data", "desc": "Pipelines and warehouse" }
      ]
    },
    {
      "type": "checklist",
      "title": "Onboarding checklist",
      "control": "checkbox",
      "items": [
        { "label": "Profile completed", "state": "done" },
        { "label": "2FA enabled", "state": "done" },
        { "label": "First project created", "state": "pending" },
        { "label": "Billing connected", "desc": "needs an admin", "state": "blocked" }
      ]
    },
    {
      "type": "form",
      "title": "Invite a teammate",
      "desc": "They will receive an email with a link to join your workspace.",
      "columns": 2,
      "fields": [
        { "label": "Full name", "kind": "text", "placeholder": "Jane Doe", "required": true },
        { "label": "Work email", "kind": "email", "placeholder": "jane@example.com", "required": true },
        { "label": "Role", "kind": "select", "options": ["Admin", "Editor", "Viewer"] },
        { "label": "Start date", "kind": "date", "optional": true },
        { "label": "Welcome note", "kind": "textarea", "help": "Optional — shown in the invite email." },
        { "label": "Send a copy of the invite to me", "kind": "checkbox", "checked": true }
      ],
      "submit": { "label": "Send invite" }
    }
  ]
}

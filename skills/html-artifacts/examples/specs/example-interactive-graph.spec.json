{
  "title": "Checkout Platform Service Architecture",
  "theme": "forest",
  "layout": "stack",
  "header": "banner",
  "lang": "en",
  "target": "diagram",
  "viewport": "desktop",
  "eyebrow": "EC PLATFORM · CHECKOUT DOMAIN",
  "subtitle": "An interactive diagram of the inter-service communication (HTTP / gRPC / pub-sub) in the checkout domain, spanning the frontend, backend, and data zones. Explore it by dragging, zooming, and filtering.",
  "footer": "Source: Checkout domain architecture diagram · 2026-06-07 · Platform Engineering (no dependencies, single file)",
  "sections": [
    {
      "type": "html",
      "html": "<div class=\"callout callout-box callout-note\" data-reveal>\n  <svg class=\"callout-glyph\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" role=\"img\" aria-label=\"How to use\">\n    <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n    <path d=\"M12 11v5M12 7.5h.01\"/>\n  </svg>\n  <div>\n    <p class=\"callout-title\">How to use this diagram</p>\n    <div class=\"callout-body\">\n      <p><strong>Drag a node</strong> to reposition it; the connecting lines (edges) follow automatically. <strong>Scroll to zoom in and out</strong>, and <strong>drag the background to pan the whole view</strong>. <strong>Click a legend chip</strong> below to dim every node outside that zone (frontend / backend / data) so you can focus on an area of interest (multiple selections allowed; click again to clear). You can also use the keyboard: focus a node and move it with the arrow keys, zoom in with <kbd>+</kbd>, zoom out with <kbd>-</kbd>, and reset the view with <kbd>0</kbd>. To restore the original positions, press \"Reset Layout\".</p>\n    </div>\n  </div>\n</div>",
      "cssModules": [
        "callout-box"
      ]
    },
    {
      "type": "html",
      "html": "<section class=\"node-graph stack\" data-crossfilter aria-label=\"Checkout platform service architecture diagram\" data-reveal data-reveal-delay=\"120\">\n\n  <!-- cross-filter legend (chip data-filter-key === node data-series) -->\n  <div class=\"cluster ng-legend no-print\" role=\"group\" aria-label=\"Filter nodes by zone\">\n    <span class=\"chip g-1\" data-filter-key=\"g-1\"><span class=\"ng-dot\"></span>Frontend</span>\n    <span class=\"chip g-2\" data-filter-key=\"g-2\"><span class=\"ng-dot\"></span>Backend</span>\n    <span class=\"chip g-3\" data-filter-key=\"g-3\"><span class=\"ng-dot\"></span>Data</span>\n  </div>\n\n  <!-- zoom + pan stage wrapping the draggable SVG -->\n  <div class=\"stage\" data-zoompan data-zoom-min=\"0.4\" data-zoom-max=\"2.6\" tabindex=\"0\">\n    <div class=\"zoom-controls no-print\">\n      <button class=\"btn btn-ghost btn-sm\" data-zoom-in aria-label=\"Zoom in\">+</button>\n      <button class=\"btn btn-ghost btn-sm\" data-zoom-out aria-label=\"Zoom out\">&minus;</button>\n      <button class=\"btn btn-ghost btn-sm\" data-zoom-reset aria-label=\"Reset view\">&#10530;</button>\n      <span class=\"zoom-readout\" data-zoom-readout>100%</span>\n    </div>\n\n    <svg viewBox=\"0 0 1000 600\" data-draggable role=\"img\" aria-label=\"Checkout platform service architecture diagram (nodes are draggable)\">\n      <g data-viewport>\n\n        <!-- ===== zone background labels (decorative, backmost) ===== -->\n        <text x=\"120\" y=\"40\" fill=\"var(--text-muted)\" font-family=\"var(--font-mono)\" font-size=\"13\" letter-spacing=\"0.06em\" text-anchor=\"middle\">FRONTEND</text>\n        <text x=\"500\" y=\"40\" fill=\"var(--text-muted)\" font-family=\"var(--font-mono)\" font-size=\"13\" letter-spacing=\"0.06em\" text-anchor=\"middle\">BACKEND</text>\n        <text x=\"880\" y=\"40\" fill=\"var(--text-muted)\" font-family=\"var(--font-mono)\" font-size=\"13\" letter-spacing=\"0.06em\" text-anchor=\"middle\">DATA</text>\n\n        <!-- ===== edges (drawn before nodes = behind) ===== -->\n        <line class=\"ng-edge\" data-edge data-from=\"web\" data-to=\"bff\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"web-bff\">HTTP</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"mobile\" data-to=\"bff\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"mobile-bff\">HTTP</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"bff\" data-to=\"order\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"bff-order\">gRPC</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"order\" data-to=\"payment\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"order-payment\">gRPC</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"order\" data-to=\"orderdb\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"order-orderdb\">SQL</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"payment\" data-to=\"orderdb\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"payment-orderdb\">SQL</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"payment\" data-to=\"events\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"payment-events\">pub-sub</text>\n\n        <line class=\"ng-edge\" data-edge data-from=\"order\" data-to=\"events\"/>\n        <text class=\"ng-edge-label\" data-edge-label=\"order-events\">pub-sub</text>\n\n        <!-- ===== nodes (after edges = in front) ===== -->\n        <g class=\"ng-node g-1\" data-node=\"web\" data-series=\"g-1\"\n           transform=\"translate(40,130)\" role=\"group\" aria-label=\"Web order page (frontend, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Web Order Page</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">Next.js storefront</text>\n        </g>\n        <g class=\"ng-node g-1\" data-node=\"mobile\" data-series=\"g-1\"\n           transform=\"translate(40,370)\" role=\"group\" aria-label=\"Mobile app (frontend, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Mobile App</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">iOS / Android</text>\n        </g>\n        <g class=\"ng-node g-2\" data-node=\"bff\" data-series=\"g-2\"\n           transform=\"translate(420,250)\" role=\"group\" aria-label=\"BFF API gateway (backend, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">BFF Gateway</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">checkout-bff</text>\n        </g>\n        <g class=\"ng-node g-2\" data-node=\"order\" data-series=\"g-2\"\n           transform=\"translate(420,90)\" role=\"group\" aria-label=\"Order service (backend, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Order Service</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">order-svc</text>\n        </g>\n        <g class=\"ng-node g-2\" data-node=\"payment\" data-series=\"g-2\"\n           transform=\"translate(420,420)\" role=\"group\" aria-label=\"Payment service (backend, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Payment Service</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">payment-svc</text>\n        </g>\n        <g class=\"ng-node g-3\" data-node=\"orderdb\" data-series=\"g-3\"\n           transform=\"translate(800,130)\" role=\"group\" aria-label=\"Order database (data, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Order DB</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">PostgreSQL (HA)</text>\n        </g>\n        <g class=\"ng-node g-3\" data-node=\"events\" data-series=\"g-3\"\n           transform=\"translate(800,370)\" role=\"group\" aria-label=\"Event platform (data, draggable)\">\n          <rect class=\"ng-box\" width=\"172\" height=\"60\" rx=\"10\"/>\n          <text class=\"ng-label\" x=\"14\" y=\"28\">Event Platform</text>\n          <text class=\"ng-label\" x=\"14\" y=\"46\" fill=\"var(--text-muted)\" font-weight=\"400\" font-size=\"11\">Kafka topics</text>\n        </g>\n\n      </g>\n    </svg>\n  </div>\n\n  <!-- restore the initial node layout -->\n  <button class=\"btn btn-ghost btn-sm no-print\" data-drag-reset>Reset Layout</button>\n</section>",
      "cssModules": [
        "node-graph"
      ]
    }
  ]
}

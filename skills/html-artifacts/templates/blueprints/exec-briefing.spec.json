      "html": "<!-- module: okr-board (hand-pasted, filled) -->\n<figure class=\"okr card-outlined\" aria-label=\"FY2026 全社OKR進捗（Q1時点）\">\n  <figcaption class=\"okr-title\">FY2026 全社OKR進捗（Q1時点）</figcaption> <!-- e.g. 2026 Q3 OKR -->\n  <div class=\"okr-grid\">\n\n    <!-- ── one .okr-obj per Objective ─────────────────────────────────────── -->\n    <section class=\"okr-obj\">\n      <span class=\"okr-kicker\">O1</span>   <!-- e.g. O1 -->\n      <h3 class=\"okr-obj-name\">製造DXで生産性を全社最適化する</h3>       <!-- e.g. 定着率No.1のプロダクト体験をつくる -->\n      <div class=\"okr-krs\">\n        <!-- ── one .okr-kr per Key Result; .is-ontrack | .is-atrisk sets colour ─ -->\n        <div class=\"okr-kr is-ontrack\">\n          <span class=\"okr-kr-name\">主要3ラインのMES導入率 40%→75%</span>       <!-- e.g. 継続率を35%→48%に -->\n          <div class=\"okr-meta\">\n            <span class=\"okr-bar\" style=\"--okr-v:72%\"></span>\n            <span class=\"okr-pct\">68%</span>        <!-- e.g. 72% -->\n            <span class=\"okr-chip\">順調</span>    <!-- e.g. 順調 -->\n          </div>\n        </div>\n        <div class=\"okr-kr is-atrisk\">\n          <span class=\"okr-kr-name\">設備総合効率(OEE) 78%→85%</span>       <!-- e.g. NPSを+12→+30に -->\n          <div class=\"okr-meta\">\n            <span class=\"okr-bar\" style=\"--okr-v:44%\"></span>\n            <span class=\"okr-pct\">44%</span>        <!-- e.g. 41% -->\n            <span class=\"okr-chip\">要注意</span>    <!-- e.g. 要注意 -->\n          </div>\n        </div>\n        <!-- ↑ repeat: one .okr-kr per Key Result -->\n      </div>\n    </section>\n\n    <section class=\"okr-obj\">\n      <span class=\"okr-kicker\">O2</span>   <!-- e.g. O2 -->\n      <h3 class=\"okr-obj-name\">高付加価値サービスへ収益構造を転換する</h3>       <!-- e.g. 収益基盤を健全化する -->\n      <div class=\"okr-krs\">\n        <div class=\"okr-kr is-ontrack\">\n          <span class=\"okr-kr-name\">保守サービス売上比率 12%→18%</span>       <!-- e.g. 粗利率を58%→65%に -->\n          <div class=\"okr-meta\">\n            <span class=\"okr-bar\" style=\"--okr-v:82%\"></span>\n            <span class=\"okr-pct\">82%</span>        <!-- e.g. 88% -->\n            <span class=\"okr-chip\">順調</span>    <!-- e.g. 順調 -->\n          </div>\n        </div>\n      </div>\n    </section>\n    <!-- ↑ repeat: one .okr-obj per Objective (2-3 recommended) -->\n\n  </div>\n</figure>",
      "cssModules": [
        "okr-board"
      ]
    },

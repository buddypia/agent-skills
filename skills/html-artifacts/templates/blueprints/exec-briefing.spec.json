  "_recipe": {
    "id": "exec-briefing",
    "name": "経営ブリーフィング（役員会資料）",
    "genre": "経営資料",
    "purpose": "四半期の業績と全社戦略テーマ（ここではDX推進）の進捗を、役員が5分で把握し次の意思決定に進めるよう、結論・数字・リスク・今後施策の順で1枚に凝縮する。",
    "audience": "取締役・執行役員（経営会議／役員会の出席者）",
    "triggers": {
      "ja": [
        "経営資料を作りたい",
        "役員会のブリーフィング資料",
        "四半期の経営サマリー",
        "取締役会向けの業績報告",
        "DX推進の進捗を経営層に",
        "経営レビュー資料"
      ],
      "en": [
        "exec briefing deck",
        "board quarterly review",
        "leadership business summary"
      ],
      "ko": [
        "경영 브리핑 자료",
        "이사회 분기 리뷰",
        "경영진 요약 보고"
      ]
    },
    "axes": {
      "theme": "slate",
      "layout": "bento",
      "header": "split",
      "density": "comfortable",
      "rationale": "落ち着いた slate は経営文書の信頼感に合致。bento で業績トレンドとセグメントを2枚並置しダッシュボード感を出しつつ、要点・OKR・ロードマップは全幅。split ヘッダで対象期間/報告者/機密区分の provenance を明示。"
    },
    "outline": [
      {
        "n": 1,
        "type": "html:key-takeaways",
        "role": "経営サマリー（結論先出し）",
        "required": true,
        "guide": "「これだけ読めば足りる」3点。達成した成果・改善したKPI・次に判断すべき論点を各1行。数字を必ず入れる。",
        "volume": "3項目（各1〜2文）"
      },
      {
        "n": 2,
        "type": "kpi",
        "role": "業績ハイライト",
        "required": true,
        "guide": "売上・利益率・戦略テーマKPI・稼働率など4枚。deltaとdirは good-news=up(緑▲)/bad-news=down(赤▼)で意味づけを揃える。",
        "volume": "4カード"
      },
      {
        "n": 3,
        "type": "chart",
        "role": "業績トレンド",
        "required": true,
        "guide": "直近4四半期の売上等を line で。displayに¥表記。右のセグメント図と横並び。",
        "volume": "4データ点"
      },
      {
        "n": 4,
        "type": "chart",
        "role": "事業セグメント別内訳",
        "required": false,
        "guide": "bar で当四半期の売上を事業別に。合計を上のKPI売上高と一致させる。",
        "volume": "3〜5系列"
      },
      {
        "n": 5,
        "type": "html:okr-board",
        "role": "全社OKR進捗",
        "required": true,
        "guide": "2目標×各1〜2 KR。進捗%とバー幅(--okr-v)を一致させ、順調=is-ontrack/要注意=is-atrisk。",
        "volume": "2目標・3KR"
      },
      {
        "n": 6,
        "type": "callout",
        "role": "主要リスクと対応",
        "required": true,
        "guide": "warning で最大リスク1件を、影響額・対応・担当・期限まで具体化。",
        "volume": "1段落"
      },
      {
        "n": 7,
        "type": "html:roadmap",
        "role": "今後の重点施策",
        "required": true,
        "guide": "4期間×3レーンの粗いロードマップ。施策バーは grid-column でQをまたぐようにcatN色分け。",
        "volume": "3レーン・5施策"
      }
    ],
    "swaps": [
      {
        "slot": 4,
        "default": "chart（セグメント別 bar）",
        "alternative": "table（セグメント/売上/前年比/営業利益/状況）",
        "when": "定量内訳より前年比や状況コメントまで見せたいとき"
      },
      {
        "slot": 7,
        "default": "html:roadmap",
        "alternative": "timeline（主要マイルストーンの時系列）",
        "when": "施策の期間帯より完了時点の並びを見せたいとき"
      },
      {
        "slot": 1,
        "default": "html:key-takeaways",
        "alternative": "callout(variant:tldr)",
        "when": "結論が1メッセージに集約でき箇条書きが不要なとき"
      },
      {
        "slot": 5,
        "default": "html:okr-board",
        "alternative": "html:kpi-tree",
        "when": "目標整合より単一指標の要因分解を示したいとき"
      }
    ],
    "modules": [

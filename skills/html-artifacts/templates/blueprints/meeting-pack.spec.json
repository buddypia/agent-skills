      "html": "<!-- module: agenda (hand-pasted, filled) -->\n<figure class=\"agd card-outlined\" aria-label=\"会議次第（90分）\">\n  <figcaption class=\"agd-title\">会議次第（90分）</figcaption> <!-- e.g. カンファレンス Day 1 -->\n  <div class=\"agd-list\">\n\n    <!-- ── one .agd-block per part of the day (morning / afternoon / …) ────── -->\n    <section class=\"agd-block\">\n      <p class=\"agd-block-label\">前半（説明・共有）</p> <!-- e.g. 午前 -->\n\n      <!-- ── one .agd-slot per session ─────────────────────────────────────── -->\n      <div class=\"agd-slot\">\n        <span class=\"agd-time\">14:00-14:10</span> <!-- e.g. 09:00-09:30 -->\n        <div class=\"agd-body\">\n          <p class=\"agd-session\">開会・本日のゴール確認</p>        <!-- e.g. 開会あいさつと全体像 -->\n          <div class=\"agd-meta\">\n            <span class=\"chip\">議長: 高橋</span>          <!-- e.g. 田中 実行委員長 -->\n            <span class=\"agd-track\">全体</span>     <!-- e.g. メインホール（省略可） -->\n          </div>\n        </div>\n      </div>\n\n      <div class=\"agd-slot\">\n        <span class=\"agd-time\">14:10-14:40</span> <!-- e.g. 09:30-10:20 -->\n        <div class=\"agd-body\">\n          <p class=\"agd-session\">各選択肢の評価結果 説明</p>        <!-- e.g. 基調講演：これからのプロダクト開発 -->\n          <div class=\"agd-meta\">\n            <span class=\"chip\">情シス: 中村</span>          <!-- e.g. 佐藤 花子 -->\n            <span class=\"agd-track\">説明40分</span>     <!-- e.g. Track A -->\n          </div>\n        </div>\n      </div>\n      <!-- ↑ repeat: one .agd-slot per session -->\n    </section>\n\n    <section class=\"agd-block\">\n      <p class=\"agd-block-label\">後半（討議・意思決定）</p> <!-- e.g. 午後 -->\n      <div class=\"agd-slot\">\n        <span class=\"agd-time\">14:40-15:30</span> <!-- e.g. 13:00-13:45 -->\n        <div class=\"agd-body\">\n          <p class=\"agd-session\">論点討議と意思決定</p>        <!-- e.g. 分科会：導入事例に学ぶ -->\n          <div class=\"agd-meta\">\n            <span class=\"chip\">進行: 高橋</span>          <!-- e.g. 鈴木 太郎 -->\n            <span class=\"agd-track\">討議・決定50分</span>     <!-- e.g. Track B / 302 -->\n          </div>\n        </div>\n      </div>\n    </section>\n    <!-- ↑ repeat: one .agd-block per part of the day -->\n\n  </div>\n</figure>",

  "_recipe": {
    "id": "project-report",
    "name": "プロジェクト進捗報告（週次／月次）",
    "genre": "プロジェクト報告",
    "purpose": "PMがプロジェクトの健康状態（全体RAG・ワークストリーム別）と進捗・課題・エスカレーション・次アクションを定例で共有し、遅延に対する意思決定を引き出す。",
    "audience": "ステアリングコミッティ／プロジェクトスポンサー・関係部門リード",
    "triggers": {
      "ja": [
        "プロジェクトの進捗報告",
        "週次ステータスレポート",
        "月次のPJ報告資料",
        "RAGステータスをまとめたい",
        "ステコミ資料を作りたい",
        "エスカレーション事項を整理"
      ],
      "en": [
        "project status report",
        "weekly PM update",
        "steering committee deck"
      ],
      "ko": [
        "프로젝트 진행 보고",
        "주간 상태 보고서",
        "스티어링 위원회 자료"
      ]
    },
    "axes": {
      "theme": "slate",
      "layout": "stack",
      "header": "split",
      "density": "comfortable",
      "rationale": "stack は状況→数字→課題→次アクションの一本道の読み順に最適。slate は定例報告の落ち着いたトーン。split ヘッダに報告期間/PM/全体RAGを常設し provenance を明確化。"
    },
    "outline": [
      {
        "n": 1,
        "type": "html:project-status",
        "role": "状況スナップショット（結論先出し）",
        "required": true,
        "guide": "全体RAGと期間をヘッダに、ワークストリームごとにRAG・進捗%・オーナー・次マイルストーン。バー幅(--pst-v)と%を一致させ、色は is-green/-amber/-red。",
        "volume": "3〜5ワークストリーム"
      },
      {
        "n": 2,
        "type": "kpi",
        "role": "進捗ハイライト",
        "required": true,
        "guide": "進捗率・予算消化・未解決課題・高リスク件数など4枚。悪化はdir:downで赤▼。",
        "volume": "4カード"
      },
      {
        "n": 3,
        "type": "chart",
        "role": "バーンダウン推移",
        "required": true,
        "guide": "残タスク数（または残工数）の週次推移を line で。理想線が要るなら2系列に。",
        "volume": "4〜6データ点"
      },
      {
        "n": 4,
        "type": "table",
        "role": "課題一覧",
        "required": true,
        "guide": "課題／影響／対応方針／期限。影響度はbadge(danger/warning/info)。行数が多ければpaginate。",
        "volume": "4〜8行"
      },
      {
        "n": 5,
        "type": "html:raci-matrix",
        "role": "体制・責任分担",
        "required": false,
        "guide": "タスク×役割でR/A/C/I。各行のAは1つだけ。凡例を必ず添える。",
        "volume": "3〜5タスク×3〜4役割"
      },
      {
        "n": 6,
        "type": "callout",
        "role": "エスカレーション事項",
        "required": true,
        "guide": "warning で意思決定を要する1件を、依頼内容・期限・決定の場まで明記。",
        "volume": "1段落"
      },
      {
        "n": 7,
        "type": "timeline",
        "role": "直近マイルストーン",
        "required": true,
        "guide": "完了/進行中/予定を status(done/active/todo)で。日付は昇順。",
        "volume": "4〜6件"
      },
      {
        "n": 8,
        "type": "checklist",
        "role": "来週／来月のアクション",
        "required": true,
        "guide": "checkbox で次期間のToDo。state(done/pending/blocked/todo)で状態を色分け。",
        "volume": "4〜6件"
      }
    ],
    "swaps": [
      {
        "slot": 5,
        "default": "html:raci-matrix",
        "alternative": "table（課題の追加詳細一覧）",
        "when": "責任分担が固定で、課題の粒度を上げたいとき"
      },
      {
        "slot": 3,
        "default": "chart(line バーンダウン)",
        "alternative": "chart(barstacked ワークストリーム別工数)",
        "when": "残量推移よりストリーム別の工数配分を見せたいとき"
      },
      {
        "slot": 8,
        "default": "checklist",
        "alternative": "stepper（承認フローの次ステップ）",
        "when": "ToDoではなく手続きの次工程を示したいとき"
      },
      {
        "slot": 7,
        "default": "timeline",
        "alternative": "html:roadmap",
        "when": "週次の細かい節目より四半期粒度の計画を示したいとき"
      }
    ],
    "modules": [
      "project-status",
      "kpi",
      "chart",
      "table",
      "raci-matrix",
      "callout",
      "timeline",
      "checklist"
    ]
  }

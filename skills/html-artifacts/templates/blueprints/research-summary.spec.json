  "_recipe": {
    "id": "research-summary",
    "name": "調査報告書（市場/ユーザー調査）",
    "genre": "調査報告",
    "purpose": "市場・ユーザー調査の結果を主要ファインディング起点で整理し、意思決定者へ推奨アクションを提示する。",
    "audience": "事業責任者・企画・マーケ・政策担当",
    "triggers": {
      "ja": [
        "ユーザー調査の報告書を作って",
        "アンケート結果をまとめて",
        "市場調査レポートを作りたい",
        "調査の主要ファインディングを可視化",
        "定量調査のサマリー"
      ],
      "en": [
        "survey report",
        "user research summary",
        "market research findings"
      ],
      "ko": [
        "설문 조사 보고서",
        "사용자 리서치 요약",
        "시장 조사 리포트"
      ]
    },
    "axes": {
      "theme": "birchline",
      "layout": "stack",
      "header": "banner",
      "density": "comfortable",
      "rationale": "読み物としての調査報告はbirchline+stackで縦読みの可読性を優先。bannerヘッダーで調査期間/手法/n数のprovenanceを冒頭バンドに明示し、default-sandwich警告も回避する。"
    },
    "outline": [
      {
        "n": 1,
        "type": "html:key-takeaways",
        "role": "主要ファインディング（結論先出し）",
        "required": true,
        "guide": "3〜5個の結論を数字付きで。読者が最初に読む要点。",
        "volume": "4行"
      },
      {
        "n": 2,
        "type": "statlist",
        "role": "調査概要",
        "required": true,
        "guide": "n数/回収率/対象/期間/手法などのメタ数値を一覧化。",
        "volume": "6〜8項目"
      },
      {
        "n": 3,
        "type": "chart",
        "role": "回答分布",
        "required": true,
        "guide": "主要設問の回答分布をbarで。合計100%になる構成に。",
        "volume": "5件"
      },
      {
        "n": 4,
        "type": "html:diverging-bar",
        "role": "賛否の年代別対比",
        "required": true,
        "guide": "賛成/反対を年代別に左右対比。widthは共通スケールで value/max。",
        "volume": "4行"
      },
      {
        "n": 5,
        "type": "html:persona-card",
        "role": "代表的なユーザー像",
        "required": false,
        "guide": "主要セグメントを擬人化（ゴール/不満/行動）。",
        "volume": "2枚"
      },
      {
        "n": 6,
        "type": "comparison",
        "role": "セグメント比較",
        "required": true,
        "guide": "関心セグメントを横並びで比較（割合/年齢/障壁）。割合の合計は100%。",
        "volume": "3列"
      },
      {
        "n": 7,
        "type": "callout",
        "role": "推奨アクション",
        "required": true,
        "guide": "最優先施策と検証方法（対象・期間）を提示。",
        "volume": "1段落"
      }
    ],
    "swaps": [
      {
        "slot": 5,
        "default": "html:persona-card",
        "alternative": "html:quote-block（代表的な自由回答）",
        "when": "生の声を引用で見せたいとき"
      },
      {
        "slot": 3,
        "default": "chart(bar) 回答分布",
        "alternative": "chart(donut) 構成比",
        "when": "割合の内訳を強調したいとき"
      },
      {
        "slot": 6,
        "default": "comparison セグメント比較",
        "alternative": "table クロス集計",
        "when": "多軸のクロス集計を細かく見せたいとき"
      }
    ],
    "modules": [
      "key-takeaways",
      "statlist",
      "chart",
      "diverging-bar",
      "persona-card",
      "comparison",
      "callout"
    ]
  }

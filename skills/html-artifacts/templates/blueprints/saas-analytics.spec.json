  "_recipe": {
    "id": "saas-analytics",
    "name": "SaaS事業分析レポート（月次）",
    "genre": "SaaS分析",
    "purpose": "国内SaaS事業のMRR・リテンション・獲得効率を月次で経営層に報告し、次アクションの意思決定を促す。",
    "audience": "経営層・事業責任者・事業企画",
    "triggers": {
      "ja": [
        "SaaSの月次事業レポートを作って",
        "MRRと解約率をまとめて",
        "月次のSaaS KPIダッシュボード",
        "リテンションコホートを可視化して",
        "事業レビュー資料を作りたい"
      ],
      "en": [
        "monthly SaaS report",
        "MRR churn NRR dashboard",
        "retention cohort report"
      ],
      "ko": [
        "월간 SaaS 리포트",
        "MRR 이탈률 요약",
        "리텐션 코호트 시각화"
      ]
    },
    "axes": {
      "theme": "midnight",
      "layout": "bento",
      "header": "split",
      "density": "compact",
      "rationale": "KPI+複数チャート主体のダッシュボードは§1.1 rule3のmidnight/bentoが最適。header=splitは対象月/承認者などprovenanceを右カラムに描画するため採用（compactはmeta非表示のため不可）。density=compactで情報密度を確保。"
    },
    "outline": [
      {
        "n": 1,
        "type": "kpi",
        "role": "結論先出し（主要KPI）",
        "required": true,
        "guide": "MRR/解約率/NRR/CAC/有料企業数を1行で。増加が良い指標のみdirを付け、解約率・CACはarrow誤読を避け値のみ。",
        "volume": "4〜5枚"
      },
      {
        "n": 2,
        "type": "chart",
        "role": "MRR推移",
        "required": true,
        "guide": "直近6ヶ月のMRRをlineで。displayに¥表記を入れる。",
        "volume": "span6・6点"
      },
      {
        "n": 3,
        "type": "chart",
        "role": "プラン別MRR構成",
        "required": false,
        "guide": "donutでプラン別内訳。valueの合計がMRRと一致するように。",
        "volume": "span6・3〜4区分"
      },
      {
        "n": 4,
        "type": "html:cohort-grid",
        "role": "月次リテンションコホート",
        "required": true,
        "guide": "直近5コホートのM0〜M5継続率。新しいコホートほど末尾を.cht-naで階段状に空欄化。",
        "volume": "5行"
      },
      {
        "n": 5,
        "type": "funnel",
        "role": "獲得ファネル",
        "required": true,
        "guide": "訪問→登録→有効化→有料転換。転換率は上段比で自動算出される。",
        "volume": "4段"
      },
      {
        "n": 6,
        "type": "html:composition-bar",
        "role": "獲得チャネル構成",
        "required": false,
        "guide": "今月vs前月の100%構成。各バーのwidth合計は100。",
        "volume": "2バー・4区分"
      },
      {
        "n": 7,
        "type": "table",
        "role": "セグメント別数値",
        "required": true,
        "guide": "従業員規模別に企業数/MRR/NRR/解約率。数値はKPI・合計と整合させる。",
        "volume": "3〜5行"
      },
      {
        "n": 8,
        "type": "callout",
        "role": "示唆と次アクション",
        "required": true,
        "guide": "最も効くレバー1つに絞り、担当と目標値・期限を書く。",
        "volume": "1段落"
      }
    ],
    "swaps": [
      {
        "slot": 3,
        "default": "chart(donut) プラン別MRR構成",
        "alternative": "html:composition-bar プラン構成比",
        "when": "内訳を前年比較で見せたいとき"
      },
      {
        "slot": 5,
        "default": "funnel 獲得ファネル",
        "alternative": "chart(bar) 新規/解約MRRブリッジ",
        "when": "獲得より純増要因を分解したいとき"
      },
      {
        "slot": 7,
        "default": "従業員規模セグメント",
        "alternative": "業種別/プラン別セグメント",
        "when": "読者の関心が業種構成にあるとき"
      }
    ],
    "modules": [
      "kpi",
      "chart",
      "cohort-grid",
      "funnel",
      "composition-bar",
      "table",
      "callout"
    ]
  }
}

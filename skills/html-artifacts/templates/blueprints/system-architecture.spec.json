  "_recipe": {
    "id": "system-architecture",
    "name": "システムアーキテクチャ仕様書",
    "genre": "技術ドキュメント",
    "purpose": "分散システムの全体像を「構成・処理・性能・イベント・配置・障害」の6面から示し、読み手が図を見て流れを追え、変更や障害の影響範囲まで自力で判断できる状態にする。トポロジ図1枚では答えられない問いを、それぞれ専用のモジュールで受ける構成。",
    "audience": "実装エンジニア / SRE / テックリード / アーキテクチャレビュー参加者",
    "triggers": {
      "ja": [
        "システムアーキテクチャ仕様書",
        "システム構成を解説して",
        "分散システムの設計資料",
        "アーキテクチャドキュメント",
        "OSSの内部構造を解説",
        "エンドツーエンドの処理フローを図解"
      ],
      "en": [
        "system architecture document",
        "distributed system design doc",
        "explain this platform architecture",
        "end to end architecture guide"
      ],
      "ko": [
        "시스템 아키텍처 문서",
        "분산 시스템 설계 자료",
        "플랫폼 구조 설명 자료",
        "엔드투엔드 아키텍처 가이드"
      ]
    },
    "axes": {
      "theme": "dark-focus",
      "layout": "stack",
      "header": "split",
      "density": "comfortable",
      "rationale": "図が主役の技術資料なのでdark-focusでSVGのコントラストを稼ぐ。Version/Status/Ownerを明示するsplitヘッダ。上から読み下す設計資料なのでstack。"
    },
    "outline": [
      {
        "n": 1,
        "type": "callout",
        "role": "結論先出し（概要と設計原則）",
        "required": true,
        "guide": "このシステムが何を解いているかを3文以内。以降の図を読む前提となる原則を並べる。",
        "volume": "3〜4文"
      },
      {
        "n": 2,
        "type": "kpi",
        "role": "アーキテクチャ指標",
        "required": false,
        "guide": "スループット・遅延・可用性など、設計判断の根拠になる実測値。deltaに矢印は書かない（builderが付ける）。",
        "volume": "3〜4枚"
      },
      {
        "n": 3,
        "type": "arch-explorer",
        "role": "全体トポロジとシナリオ探索",
        "required": true,
        "guide": "この資料の中心。zones/nodes/edges/scenariosをデータで渡す。SVGは手書きしない。ビルド時のwarnはすべて解消すること。scenariosの各stepは必ずedgesに存在する辺を指すこと。",
        "volume": "ノード8〜18 / シナリオ2〜4"
      },
      {
        "n": 4,
        "type": "pipeline-flow",
        "role": "データ処理の段階",
        "required": false,
        "guide": "各段階が入力を何に変えるか。arch-explorerが「何と何が繋がるか」なら、ここは「各段で何が起きるか」。",
        "volume": "4〜6段階"
      },
      {
        "n": 5,
        "type": "service-catalog",
        "role": "コンポーネント仕様一覧",
        "required": false,
        "guide": "役割・リポジトリパス・技術・ポート・責務。読者がコードに降りるための索引。",
        "volume": "5〜8件"
      },
      {
        "n": 6,
        "type": "request-trace",
        "role": "1リクエストのレイテンシ内訳",
        "required": false,
        "guide": "「時間がどこに消えるか」。合計ではなく支配的な区間を見せる。startとdurは実測値で。",

      "scenarios": [
        {
          "id": "standard",
          "name": "1. 通常リクエスト処理フロー",
          "desc": "クライアントのHTTPリクエストを認証後、ジョブキューを経由して非同期ワーカーが外部連携まで完遂する標準E2Eフロー",
          "steps": [
            {
              "step": 1,
              "from": "web",
              "to": "edge",
              "title": "クライアント要求",
              "desc": "ユーザー端末からエッジゲートウェイへのリクエスト送信",
              "proto": "HTTPS / TLS 1.3"
            },
            {
              "step": 2,
              "from": "edge",
              "to": "core_api",
              "title": "APIルーティング",
              "desc": "JWT検証後、内部マイクロサービスへgRPCルーティング",
              "proto": "gRPC"
            },
            {
              "step": 3,
              "from": "core_api",
              "to": "queue",
              "title": "非同期キューイング",
              "desc": "即時レスポンスを返し、実際の重い処理をBullMQキューへ委譲",
              "proto": "Redis BullMQ"
            },
            {
              "step": 4,
              "from": "queue",
              "to": "worker",
              "title": "ワーカーデキュー",
              "desc": "稼働中のワーカープールが順次タスクを取得して実行開始",
              "proto": "Worker Pull"
            },
            {
              "step": 5,
              "from": "worker",
              "to": "third_party",
              "title": "外部サービス配信",
              "desc": "外部APIコールを行い、結果ステータスをDBおよび分析ストアへ反映",
              "proto": "HTTPS REST"
            }
          ]
        },
        {
          "id": "batch",
          "name": "2. 大規模バッチ・監査ログフロー",
          "desc": "複数ジョブの集約実行と、ClickHouseへのゼロオーバーヘッド非同期テレメトリ蓄積",
          "steps": [
            {
              "step": 1,
              "from": "core_api",
              "to": "queue",
              "title": "バッチ一括エンキュー",
              "desc": "大口ジョブをチャンク分割してキューに投入",
              "proto": "BullMQ Pipeline"
            },
            {
              "step": 2,
              "from": "queue",
              "to": "worker",
              "title": "並列ワーカー処理",
              "desc": "スケールアウトしたワーカーが並列にジョブを消費",
              "proto": "Worker Cluster"
            },
            {
              "step": 3,
              "from": "worker",
              "to": "analytics",
              "title": "テレメトリ転送",
              "desc": "実行トレースとメトリクスをClickHouseへ非同期一括インサート",
              "proto": "Native TCP"
            }
          ]
        }
      ]
    },
    {
      "type": "pipeline-flow",
      "title": "データ処理ライフサイクル (5段階パイプライン)",
      "desc": "リクエスト受信からバリデーション、非同期変換、外部連携、フィードバックまでのデータモデル遷移",
      "stages": [
        {
          "num": 1,
          "name": "Ingestion",
          "proto": "HTTPS / Edge",
          "cards": [
            {
              "title": "エッジ受付 & WAF",
              "desc": "DDoS対策、レートリミット、JWTシグネチャ検証",
              "in": "Raw HTTPS Packet",
              "out": "Authenticated Request",
              "branches": [
                {
                  "type": "go",
                  "label": "Valid"
                },
                {
                  "type": "stop",
                  "label": "401/429 Reject"
                }
              ]
            }
          ]
        },
        {
          "num": 2,
          "name": "Validation & Enqueue",
          "proto": "JSON Schema",
          "cards": [
            {
              "title": "スキーマバリデーション",
              "desc": "Zodによる型チェックと必須メタデータの付与",
              "in": "Payload JSON",
              "out": "Enqueued Job Data",
              "branches": [
                {
                  "type": "go",
                  "label": "Queue Push"
                }
              ]
            }
          ]
        },
        {
          "num": 3,
          "name": "Worker Execution",
          "proto": "Node.js Engine",
          "cards": [
            {
              "title": "テンプレートコンパイル",
              "desc": "受信者プロファイルと変数をマージし動的コンテンツ生成",
              "in": "Job Data",
              "out": "Compiled Request",
              "branches": [
                {
                  "type": "go",
                  "label": "Success"
                },
                {
                  "type": "warn",
                  "label": "Retry (3x)"
                }
              ]
            }
          ]
        },
        {
          "num": 4,
          "name": "Dispatch",
          "proto": "REST / Socket",
          "cards": [
            {
              "title": "マルチチャネル配信",
              "desc": "プロバイダーAPIコールおよびリアルタイムWebSocket配信",
              "in": "Compiled Message",
              "out": "Provider Response",
              "branches": [
                {
                  "type": "go",
                  "label": "Delivered"
                },
                {
                  "type": "stop",
                  "label": "DLQ Failover"
                }
              ]
            }
          ]
        },
        {
          "num": 5,
          "name": "Observability",
          "proto": "ClickHouse / OLAP",
          "cards": [
            {
              "title": "監査証跡 & メトリクス",
              "desc": "ミリ秒精度の配信追跡ログとレイテンシの集約保存",
              "in": "Execution Trace",
              "out": "Dashboard Ready",
              "branches": [
                {
                  "type": "go",
                  "label": "Indexed"
                }
              ]
            }
          ]
        }
      ]
    },

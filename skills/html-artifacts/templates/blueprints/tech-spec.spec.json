  "sections": [
    {
      "type": "callout",
      "variant": "tldr",
      "title": "目的とスコープ",
      "body": "在庫同期API v2は、全国12拠点の倉庫在庫を平均800msでリアルタイム同期し、二重販売を防止するための基盤である。本仕様の対象は同期API・イベント配信・整合性保証まで。決済処理と配送手配は対象外とする。"
    },
    {
      "type": "diagram",
      "title": "システムアーキテクチャ",
      "layout": "layered",
      "zones": [
        "Edge",
        "Services",
        "Data"
      ],
      "groupLabels": {
        "1": "ステートレス",
        "2": "ステートフル"
      },
      "nodes": [
        {
          "id": "gw",
          "label": "API Gateway",
          "sub": "認証 / レート制限",
          "zone": "Edge",
          "group": 1
        },
        {
          "id": "sync",
          "label": "sync-service",
          "sub": "同期オーケストレーション",
          "zone": "Services",
          "group": 1
        },
        {
          "id": "stock",
          "label": "stock-service",
          "sub": "在庫台帳ドメイン",
          "zone": "Services",
          "group": 1
        },
        {
          "id": "pg",
          "label": "PostgreSQL",
          "sub": "在庫マスタ",
          "zone": "Data",
          "group": 2
        },
        {
          "id": "redis",
          "label": "Redis",
          "sub": "在庫キャッシュ",
          "zone": "Data",
          "group": 2
        },
        {
          "id": "bus",
          "label": "Kafka",
          "sub": "イベントバス",
          "zone": "Data",
          "group": 2
        }
      ],
      "edges": [
        {
          "from": "gw",
          "to": "sync",
          "label": "HTTP"
        },
        {
          "from": "sync",
          "to": "stock",
          "label": "gRPC"
        },
        {
          "from": "stock",
          "to": "pg"
        },
        {
          "from": "stock",
          "to": "redis",
          "label": "cache"
        },
        {
          "from": "sync",
          "to": "bus",
          "proto": "pub-sub",
          "label": "events"
        }
      ]
    },
    {
      "type": "apiendpoint",
      "title": "主要エンドポイント",
      "endpoints": [
        {
          "method": "GET",
          "path": "/v2/inventory/:sku",
          "desc": "指定SKUの現在庫を全倉庫横断で集計して取得する。",
          "params": [
            { "name": "sku", "type": "string", "required": true, "desc": "対象の商品SKU（13桁JANコード）" },
            { "name": "warehouse", "type": "string", "required": false, "desc": "倉庫IDで絞り込む（省略時は全拠点合算）" }
          ],
          "status": "200",
          "responseTone": "ok",
          "responseDesc": "倉庫別在庫と合計を含む在庫サマリJSONを返す。"
        },
        {
          "method": "POST",
          "path": "/v2/inventory/sync",
          "desc": "在庫差分を登録し、全拠点へ同期イベントを発行する。",
          "params": [
            { "name": "sku", "type": "string", "required": true, "desc": "対象の商品SKU" },
            { "name": "delta", "type": "number", "required": true, "desc": "在庫の増減数（マイナスで引当）" },
            { "name": "reason", "type": "string", "required": false, "desc": "在庫変動の理由コード（入荷/出荷/棚卸）" }
          ],
          "status": "400",
          "responseTone": "warn",
          "responseDesc": "在庫が負になる場合はバリデーションエラーを返す。"
        }
      ]
    },
    {
      "type": "filetree",
      "title": "リポジトリ構成",
      "entries": [
        { "path": "inventory-sync/", "dir": true, "note": "# サービスルート" },
        { "path": "inventory-sync/cmd/", "dir": true, "note": "# エントリポイント" },
        { "path": "inventory-sync/cmd/server.go" },
        { "path": "inventory-sync/internal/", "dir": true, "note": "# 非公開パッケージ" },
        { "path": "inventory-sync/internal/sync/", "dir": true, "note": "# 同期オーケストレーション" },
        { "path": "inventory-sync/internal/sync/orchestrator.go" },
        { "path": "inventory-sync/internal/sync/reconciler.go", "note": "# 整合性照合" },
        { "path": "inventory-sync/internal/stock/", "dir": true, "note": "# 在庫台帳ドメイン" },
        { "path": "inventory-sync/internal/stock/ledger.go" },
        { "path": "inventory-sync/internal/event/", "dir": true, "note": "# Kafkaイベント発行" },
        { "path": "inventory-sync/internal/event/publisher.go" },
        { "path": "inventory-sync/api/", "dir": true, "note": "# OpenAPI定義" },
        { "path": "inventory-sync/api/openapi.yaml" },
        { "path": "inventory-sync/deploy/", "dir": true, "note": "# k8sマニフェスト" },
        { "path": "inventory-sync/README.md", "note": "# セットアップ手順" }
      ]
    },

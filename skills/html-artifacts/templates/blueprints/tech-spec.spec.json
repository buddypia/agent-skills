    "axes": {
      "theme": "dark-focus",
      "layout": "stack",
      "header": "split",
      "density": "comfortable",
      "rationale": "diagram中心の技術資料はdark-focusが既定相性。左タイトル/右メタのsplitヘッダでVersion・Owner・Statusの出自を明示。stackで上から読み下す設計書向き。"
    },
    "outline": [
      {
        "n": 1,
        "type": "callout",
        "role": "結論先出し（目的とスコープ）",
        "required": true,
        "guide": "tldrバリアントで「何を・誰のために・どこまで」を3文以内。スコープ外も1文で明記する。",
        "volume": "3〜4文"
      },
      {
        "n": 2,
        "type": "html:toc",
        "role": "目次（2階層ナビ）",
        "required": false,

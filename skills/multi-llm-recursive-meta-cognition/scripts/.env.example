# ===========================================
# Multi-LLM Reflection Pattern Configuration (5 stages)
# Reflection-pattern multi-agent settings
# ===========================================
#
# Configuration priority (highest first):
#   1. CLI arguments (--decomposer-model, etc.)
#   2. Environment variables (this file)
#   3. Configuration file (config.yaml)
#   4. Default values
#
# ===========================================

# ===========================================
# API keys (required)
# ===========================================

# Gemini API (Decomposer / Solver)
# NOTE: the agy CLI (OAuth) is always tried first even if GEMINI_API_KEY is set here or exported
# elsewhere (e.g. by an unrelated tool) — GEMINI_API_KEY is only used as a fallback when agy itself fails.
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API (Verifier)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (Integrator / Reflector)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1  # When using Azure OpenAI, etc.

# ===========================================
# Provider-specific model IDs (optional)
# ===========================================

# Leave unset to use the current default from scripts/workflow/models.py (the single
# source of truth for model IDs).
# Out-of-date model IDs (retired snapshots, superseded generations) are refused before the
# run starts. Set MULTILLM_ALLOW_LEGACY_MODELS=1 only if a gateway remaps the old name.
# GEMINI_MODEL_ID=gemini-3.7-flash
# ANTHROPIC_MODEL_ID=claude-opus-5
# OPENAI_CHAT_MODEL_ID=codex-default  # or a concrete model available to this Codex account

# ===========================================
# Per-agent settings (optional)
# Format: REFLECTION_<ROLE>_<KEY>
# ===========================================

# [Decomposer]
# REFLECTION_DECOMPOSER_PROVIDER=gemini
# REFLECTION_DECOMPOSER_MODEL=gemini-3.7-flash
# REFLECTION_DECOMPOSER_API_KEY=your_key_here  # Takes priority over GEMINI_API_KEY
# REFLECTION_DECOMPOSER_TEMPERATURE=0.7
# REFLECTION_DECOMPOSER_TIMEOUT=300

# [Solver]
# REFLECTION_SOLVER_PROVIDER=gemini
# REFLECTION_SOLVER_MODEL=gemini-3.7-flash
# REFLECTION_SOLVER_API_KEY=your_key_here  # Takes priority over GEMINI_API_KEY
# REFLECTION_SOLVER_TEMPERATURE=0.7
# REFLECTION_SOLVER_TIMEOUT=300

# [Verifier]
# REFLECTION_VERIFIER_PROVIDER=anthropic
# REFLECTION_VERIFIER_MODEL=claude-opus-5
# REFLECTION_VERIFIER_API_KEY=your_key_here  # Takes priority over ANTHROPIC_API_KEY
# REFLECTION_VERIFIER_TEMPERATURE=0.7
# REFLECTION_VERIFIER_TIMEOUT=300

# [Integrator]
# REFLECTION_INTEGRATOR_PROVIDER=openai
# REFLECTION_INTEGRATOR_MODEL=codex-default
# REFLECTION_INTEGRATOR_API_KEY=your_key_here  # Takes priority over OPENAI_API_KEY
# REFLECTION_INTEGRATOR_BASE_URL=https://api.openai.com/v1
# REFLECTION_INTEGRATOR_TEMPERATURE=0.7
# REFLECTION_INTEGRATOR_TIMEOUT=300

# [Reflector]
# REFLECTION_REFLECTOR_PROVIDER=openai
# REFLECTION_REFLECTOR_MODEL=codex-default
# REFLECTION_REFLECTOR_API_KEY=your_key_here  # Takes priority over OPENAI_API_KEY
# REFLECTION_REFLECTOR_BASE_URL=https://api.openai.com/v1
# REFLECTION_REFLECTOR_TEMPERATURE=0.7
# REFLECTION_REFLECTOR_TIMEOUT=300

# ===========================================
# Common parameters (optional)
# ===========================================

# Temperature for all agents (default: 0.7)
# REFLECTION_TEMPERATURE=0.7
# LLM_TEMPERATURE=0.7  # Backward compatible

# Per-stage safety cap in seconds (default: 300, raised from 120 which silently degraded stages).
# The real TOTAL bound is MULTILLM_TOTAL_DEADLINE below; this just stops one stage hanging forever.
# REFLECTION_TIMEOUT=300
# LLM_TIMEOUT_SEC=300  # Backward compatible
#
# Performance / wall-clock budget (the MULTILLM_* knobs are honored across all stages):
# MULTILLM_REASONING_EFFORT=high   # Claude --effort + Codex reasoning (medium = faster, xhigh = slowest)
# MULTILLM_CLI_TIMEOUT=360         # per-CLI-call timeout (seconds)
# MULTILLM_TOTAL_DEADLINE=540      # whole 5-stage run budget; keeps it under a ~600s agent/Bash ceiling

# ===========================================
# DevUI settings
# ===========================================

# Port number for the DevUI server (default: 8095)
# REFLECTION_DEVUI_PORT=8095
# DEVUI_PORT=8095  # Backward compatible

# ===========================================
# Configuration file path (optional)
# ===========================================

# Specify when using a YAML/JSON configuration file
# CONFIG_FILE=config.yaml

# ===========================================
# Default values
# ===========================================
# Decomposer: gemini / gemini-3.7-flash
# Solver:    gemini / gemini-3.7-flash
# Verifier:  anthropic / claude-opus-5
# Integrator: openai / codex-default (Codex CLI account default)
# Reflector:  openai / codex-default (Codex CLI account default)
#
# View configuration details: python main.py --show-config
